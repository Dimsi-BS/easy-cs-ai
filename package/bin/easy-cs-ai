#!/usr/bin/env bash
# easy-cs-ai: dispatcher over the layer 1 install scripts, see docs/spec-cli.md.
# Implemented: help, version, status, install, uninstall, add, remove (in
# lib/cli-models.sh), apply (lib/cli-apply.sh), component (contract actions of a
# component, and the lists), exec (native tool commands), generate (hands over to
# vm_script/).
set -euo pipefail

readonly CLI_VERSION=0.1.0-rc3
readonly CHANGING_ACTIONS=" install uninstall add-model remove-model add-upstream remove-upstream add-site remove-site add-endpoint remove-endpoint "

# --- Locating the tree ----------------------------------------------------------

find_home() {
    local here candidate
    here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
    for candidate in "${EASY_CS_AI_HOME:-}" "$here/../lib/easy-cs-ai" "$here/../../install_scripts" /usr/lib/easy-cs-ai; do
        if [[ -n "$candidate" && -r "$candidate/lib/common.sh" ]]; then
            (cd "$candidate" && pwd)
            return 0
        fi
    done
    printf '[ERROR] cannot find the easy-cs-ai scripts (set EASY_CS_AI_HOME)\n' >&2
    exit 1
}

HOME_DIR="$(find_home)"
readonly HOME_DIR
export EASY_CS_AI_LIB="$HOME_DIR/lib"
# shellcheck source=../../install_scripts/lib/common.sh
source "$EASY_CS_AI_LIB/common.sh"
# shellcheck source=../../install_scripts/lib/cli-base.sh
source "$EASY_CS_AI_LIB/cli-base.sh"
# shellcheck source=../../install_scripts/lib/cli-models.sh
source "$EASY_CS_AI_LIB/cli-models.sh"
# shellcheck source=../../install_scripts/lib/cli-apply.sh
source "$EASY_CS_AI_LIB/cli-apply.sh"
# shellcheck source=../../install_scripts/lib/cli-ai.sh
source "$EASY_CS_AI_LIB/cli-ai.sh"

DRY=0
GFLAGS=()

# tree_unicode: succeeds when the tree of the help is drawn with box-drawing
# characters: a UTF-8 locale (LC_ALL, else LC_CTYPE, else LANG), whether or not
# the output is a terminal; EASY_CS_AI_CHARSET=unicode|ascii overrides it.
tree_unicode() {
    case "${EASY_CS_AI_CHARSET:-auto}" in
    unicode) return 0 ;;
    ascii) return 1 ;;
    esac
    local locale="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
    locale="${locale,,}"
    [[ "$locale" == *utf-8* || "$locale" == *utf8* ]]
}

# tree_row <depth> <prefix> <branch> <text> [<description>]: one line of the
# tree, the description in one column; it is dropped when it would pass 100
# columns. The width is computed from the depth (a prefix and a branch are 4
# columns each), not from the bytes, so it does not depend on the locale.
tree_row() {
    local depth="$1" prefix="$2" branch="$3" text="$4" desc="${5:-}"
    local width=$((4 * (depth + 1) + ${#text}))
    if [[ -z "$desc" ]]; then
        printf '%s%s%s\n' "$prefix" "$branch" "$text"
    elif ((width < 50)); then
        printf '%s%s%s%*s %s\n' "$prefix" "$branch" "$text" $((50 - width)) '' "$desc"
    elif ((width + 2 + ${#desc} <= 100)); then
        printf '%s%s%s  %s\n' "$prefix" "$branch" "$text" "$desc"
    else
        printf '%s%s%s\n' "$prefix" "$branch" "$text"
    fi
}

# print_tree: every command of the CLI as one tree. The components under
# `component` are the scripts shipped, by name: nothing is run.
print_tree() {
    local T L V B t n names last_type last_name
    if tree_unicode; then
        T='├── ' L='└── ' V='│   ' B='    '
        printf 'easy-cs-ai\n│\n'
    else
        T='+-  ' L='`-  ' V='|   ' B='    '
        printf 'easy-cs-ai\n|\n'
    fi
    tree_row 0 '' "$T" 'status' 'installed components, live status'
    tree_row 0 '' "$T" 'install' 'install components'
    tree_row 1 "$V" "$T" '<type> <name> [--default] [options]' 'one component'
    tree_row 1 "$V" "$L" '[<type>] --defaults' 'the default choices'
    tree_row 0 '' "$T" 'uninstall' 'uninstall components'
    tree_row 1 "$V" "$T" '<type> <name> [--purge] [--force]' 'one component'
    tree_row 1 "$V" "$L" '[<type>] --all [--purge] [--force]' 'everything installed'
    tree_row 0 '' "$T" 'add' 'add a model to an engine and wire it'
    tree_row 1 "$V" "$L" '<model> [--engine <n>] [--chat-interface <n>] [--no-chat-interface] [--defaults] [--force]'
    tree_row 0 '' "$T" 'remove' 'unwire a model and remove it'
    tree_row 1 "$V" "$T" '<model> [--engine <n>]' 'one model'
    tree_row 1 "$V" "$L" '--all [--engine <n>]' 'every model'
    tree_row 0 '' "$T" 'apply <file|-> [--vm <n>] [--prune]' 'make the machine match a file'
    tree_row 0 '' "$T" 'generate [--config-only] [--config <file>]' 'VM post-install script generator'
    tree_row 0 '' "$T" 'component' 'the types and their components'
    last_type="${TYPES[${#TYPES[@]} - 1]}"
    for t in "${TYPES[@]}"; do
        if [[ "$t" == "$last_type" ]]; then
            tree_row 1 "$V" "$L" "$t"
        else
            tree_row 1 "$V" "$T" "$t"
        fi
        mapfile -t names < <(component_names "$t")
        ((${#names[@]} > 0)) || continue
        last_name="${names[${#names[@]} - 1]}"
        for n in "${names[@]}"; do
            local pad="$V"
            [[ "$t" == "$last_type" ]] && pad="$B"
            if [[ "$n" == "$last_name" ]]; then
                tree_row 2 "$V$pad" "$L" "$n <action> [arguments]"
            else
                tree_row 2 "$V$pad" "$T" "$n <action> [arguments]"
            fi
        done
    done
    tree_row 0 '' "$T" 'exec <type> <name> <command> [arguments]' "the component's own program"
    tree_row 0 '' "$T" 'guide' 'how to use this CLI (AI agent, program)'
    tree_row 0 '' "$T" 'catalog' 'what can be installed'
    tree_row 0 '' "$T" 'host' 'this machine: CPU, memory, disk, GPU'
    tree_row 0 '' "$T" 'config' 'the configuration format and checks'
    tree_row 1 "$V" "$T" 'schema' 'the format, as a JSON Schema'
    tree_row 1 "$V" "$L" 'validate <file|-> [--target] [--vm <n>]' 'check a file, show its plan'
    tree_row 0 '' "$T" 'help'
    tree_row 0 '' "$L" 'version'
}

usage() {
    cat <<'EOF'
Usage: easy-cs-ai [--verbose] [--dry-run] [--json] <command> [arguments]

AI agent or program: run `easy-cs-ai guide` first, it tells how to use this CLI.

EOF
    print_tree
    cat <<'EOF'

--json prints one JSON document on stdout instead of the human output (for programs).

`ecsai` is the short name of `easy-cs-ai`: both run the same program.
EOF
}

# --- Helpers ----------------------------------------------------------------------

need_root() {
    if is_test_root || ((EUID == 0)); then
        return 0
    fi
    fail "$EXIT_PRECONDITION" "this command must run as root" "try: sudo easy-cs-ai $*"
}

# resolve_script <type> <name>: print the script path or fail with exit 2.
resolve_script() {
    local path
    is_type "$1" || fail "$EXIT_USAGE" "unknown component type '$1'" "types: ${TYPES[*]}"
    path="$(script_path "$1" "$2")"
    if [[ ! -x "$path" && ! -f "$path" ]]; then
        fail "$EXIT_USAGE" "unknown $1 '$2'" "available: $(component_names "$1" | tr '\n' ' ')"
    fi
    printf '%s\n' "$path"
}

# run_script <type> <name> <args…>: run a script, passing streams through.
run_script() {
    local path rc=0 label
    path="$(resolve_script "$1" "$2")"
    label="${3:-} $1 $2"
    shift 2
    bash "$path" "$@" "${GFLAGS[@]}" || rc=$?
    record_step "$label" "$rc"
    return "$rc"
}

# --- status -----------------------------------------------------------------------

cmd_status() {
    _require_jq
    local name json rc=0 type status_json script rows=() unhealthy=0 unreadable=0
    local names
    names="$(state_list)"
    for name in $names; do
        if ! json="$(state_read "$name" 2>/dev/null)"; then
            log_error "state of $name cannot be read ($(state_dir)/components/$name.json)"
            unreadable=1
            rows+=("$(jq -nc --arg n "$name" '{name: $n, type: null, version: "?", default: false, running: null, healthy: null, models: []}')")
            continue
        fi
        type="$(jq -r '.type' <<<"$json")"
        script="$(script_path "$type" "$name")"
        status_json='{"running":false,"healthy":false}'
        if [[ -f "$script" ]]; then
            status_json="$(timeout 15 bash "$script" status 2>/dev/null)" || true
            jq -e . >/dev/null 2>&1 <<<"$status_json" || status_json='{"running":false,"healthy":false}'
        fi
        [[ "$(jq -r '.healthy' <<<"$status_json")" == true ]] || unhealthy=1
        rows+=("$(jq -nc --argjson s "$json" --argjson st "$status_json" '{
            name: $s.name, type: $s.type, version: $s.version, default: ($s.default // false),
            running: $st.running, healthy: $st.healthy, models: [($s.models // [])[].name]
          }')")
    done
    local all='[]'
    if ((${#rows[@]})); then
        all="$(printf '%s\n' "${rows[@]}" | jq -sc 'sort_by(.type, .name)')"
    fi
    warn_pending
    if ((_OPT_JSON)); then
        printf '%s\n' "$all"
    else
        local bold='' reset='' red='' green=''
        if use_color 1; then
            bold="$(_color_code bold)" red="$(_color_code red)" green="$(_color_code green)" reset=$'\033[0m'
        fi
        printf '%s%-14s%-16s%-10s%-9s%-9s%-9s%s%s\n' "$bold" COMPONENT TYPE VERSION DEFAULT RUNNING HEALTHY MODELS "$reset"
        jq -r '.[] | [.name, .type // "?", .version // "?",
            (if .default then "yes" else "no" end),
            (if .running == null then "?" elif .running then "yes" else "no" end),
            (if .healthy == null then "?" elif .healthy then "yes" else "no" end),
            (if (.models | length) > 0 then (.models | join(",")) else "-" end)] | @tsv' <<<"$all" |
            while IFS=$'\t' read -r c t v d r h m; do
                # pad before coloring: escape codes would count in the width
                local pr ph
                printf -v pr '%-9s' "$r"
                printf -v ph '%-9s' "$h"
                if [[ -n "$green" ]]; then
                    case "$r" in yes) pr="$green$pr$reset" ;; no) pr="$red$pr$reset" ;; esac
                    case "$h" in yes) ph="$green$ph$reset" ;; no) ph="$red$ph$reset" ;; esac
                fi
                printf '%-14s%-16s%-10s%-9s%s%s%s\n' "$c" "$t" "$v" "$d" "$pr" "$ph" "$m"
            done
    fi
    if [[ -z "$names" ]]; then
        log_info "nothing installed, try: easy-cs-ai install engine ollama"
    fi
    if ((unreadable)); then
        rc=1
    elif ((unhealthy)); then
        rc=$EXIT_VERIFY
    fi
    return "$rc"
}

# warn_pending: a manifest without a state is a failed install to clean.
warn_pending() {
    local f name type
    for f in "$(state_dir)"/pending/*.json; do
        [[ -e "$f" ]] || continue
        name="$(basename "$f" .json)"
        if ! state_read "$name" >/dev/null 2>&1; then
            type="$(jq -r '.type' "$f")"
            log_warn "$name: failed install pending, run: easy-cs-ai uninstall $type $name"
        fi
    done
}

# --- install ----------------------------------------------------------------------

# missing_requirements <type> <name>: requirements of a component not installed.
missing_requirements() {
    local req
    while IFS= read -r req; do
        [[ -z "$req" ]] || is_installed "$req" || printf '%s\n' "$req"
    done < <(bash "$(resolve_script "$1" "$2")" describe | jq -r '.requires[]?')
}

# install_one <type> <name> <with-defaults> <args…>
install_one() {
    local type="$1" name="$2" defaults="$3" req rtype rname rc=0
    shift 3
    resolve_script "$type" "$name" >/dev/null
    local depth="${_INSTALL_DEPTH:-0}"
    ((depth < 8)) || fail "$EXIT_ERROR" "requirements of $name are circular"
    while IFS= read -r req; do
        [[ -n "$req" ]] || continue
        if is_type "$req"; then
            rtype="$req"
            rname="$(rank_one "$req")"
        else
            rname="$req"
            rtype="$(type_of "$req")" || fail "$EXIT_PRECONDITION" "$req is required by $name and unknown"
        fi
        if ((!defaults)); then
            fail "$EXIT_PRECONDITION" "$rname is required by $name" "easy-cs-ai install $rtype $rname"
        fi
        log_info "installing $rname (required by $name)"
        (_INSTALL_DEPTH=$((depth + 1)) install_one "$rtype" "$rname" 1) ||
            fail "$?" "could not install $rname, required by $name"
    done < <(missing_requirements "$type" "$name")
    if ((DRY)); then
        log_info "dry run: would install $type $name $*"
        return 0
    fi
    run_script "$type" "$name" install "$@" || rc=$?
    return "$rc"
}

cmd_install() {
    local type="" name="" defaults=0 args=() arg
    for arg in "$@"; do
        case "$arg" in
        --defaults) defaults=1 ;;
        *)
            if [[ -z "$type" && "$arg" != -* ]]; then
                type="$arg"
            elif [[ -z "$name" && -n "$type" && "$arg" != -* && ${#args[@]} -eq 0 ]]; then
                name="$arg"
            else
                args+=("$arg")
            fi
            ;;
        esac
    done
    if [[ -z "$type" && $defaults -eq 0 ]]; then
        fail "$EXIT_USAGE" "install needs a component" "easy-cs-ai install <type> <name>, or easy-cs-ai install --defaults"
    fi
    if [[ -n "$type" ]]; then
        is_type "$type" || fail "$EXIT_USAGE" "unknown component type '$type'" "types: ${TYPES[*]}"
    fi
    if [[ -n "$type" && -z "$name" && $defaults -eq 0 ]]; then
        fail "$EXIT_USAGE" "install $type needs a component name" "easy-cs-ai install $type $(rank_one "$type"), or easy-cs-ai install $type --defaults"
    fi
    ((DRY)) || need_root install "$@"
    if [[ -n "$name" ]]; then
        install_one "$type" "$name" "$defaults" "${args[@]}"
        return
    fi
    local t engine rank fresh_engines=()
    for t in ${type:-"${TYPES[@]}"}; do
        [[ -z "$(state_list "$t")" ]] || continue
        rank="$(rank_lookup "$t")"
        if [[ -z "$rank" ]]; then
            [[ -n "$type" ]] && rank_one "$t"
            continue
        fi
        if [[ -z "$type" && ! -f "$(script_path "$t" "$rank")" ]]; then
            log_warn "no default $t installed: $rank has no install script yet"
            continue
        fi
        install_one "$t" "$rank" 1 "${args[@]}"
        [[ "$t" != engine ]] || fresh_engines+=("$rank")
    done
    # The models come last: the chat interface is then there to be linked.
    for engine in "${fresh_engines[@]}"; do
        add_default_model "$engine"
    done
}

# add_default_model <engine>: the default model of an engine installed by this
# run. A model that does not fit or cannot be downloaded is a WARN, not a
# failed install (docs/spec-cli.md, Default model).
add_default_model() {
    local engine="$1" model rc=0
    model="$(default_model "$engine")"
    if [[ -z "$model" ]]; then
        log_info "no default model known for $engine, none added"
        return 0
    fi
    if ((DRY)); then
        log_info "dry run: would add $model to $engine"
        return 0
    fi
    log_info "adding the default model $model to $engine"
    (cmd_add "$model" --engine "$engine" --defaults) || rc=$?
    if ((rc)); then
        log_warn "default model $model not added to $engine (exit $rc), add one with: easy-cs-ai add <model> --engine $engine"
    fi
    return 0
}

# --- uninstall --------------------------------------------------------------------

slug() { tr '[:upper:]' '[:lower:]' <<<"$1" | sed 's/[^a-z0-9.-]/-/g'; }

# dependents <name>: installed components whose requires name it or its type.
dependents() {
    local other type
    type="$(state_read "$1" 2>/dev/null | jq -r '.type' || true)"
    for other in $(state_list); do
        [[ "$other" == "$1" ]] && continue
        if state_read "$other" | jq -e --arg n "$1" --arg t "$type" '(.requires // []) | any(. == $n or . == $t)' >/dev/null; then
            printf '%s\n' "$other"
        fi
    done
}

# unwire_models <engine-models-json>: best effort clean-up after an engine is gone.
unwire_models() {
    local engine="$1" models="$2" model upstream chat
    while IFS= read -r model; do
        upstream="$engine-$(slug "$model")"
        jq -r --arg m "$model" '.[] | select(.name == $m) | .exposed_via // empty' <<<"$models" | while read -r proxy; do
            run_script proxy "$proxy" remove-upstream "$upstream" || log_warn "could not remove upstream $upstream from $proxy"
        done
        jq -r --arg m "$model" '.[] | select(.name == $m) | (.linked_to // [])[]' <<<"$models" | while read -r chat; do
            run_script chat-interface "$chat" remove-endpoint "$upstream" || log_warn "could not remove endpoint $upstream from $chat"
        done
    done < <(jq -r '.[].name' <<<"$models")
}

# clear_wiring <proxy-or-chat-name>: forget it in the models of every engine.
clear_wiring() {
    local engine
    for engine in $(state_list engine); do
        state_write "$engine" "$(state_read "$engine" | jq --arg n "$1" '{ name: .name, type: .type, models: ((.models // []) | map(
            (if .exposed_via == $n then .exposed_via = null else . end)
            | .linked_to = ((.linked_to // []) | map(select(. != $n)))))}')"
    done
}

uninstall_one() {
    local type="$1" name="$2" models='[]' rc=0 list
    shift 2
    ((DRY)) || need_root uninstall "$type" "$name" "$@"
    if [[ "$type" == engine ]]; then
        models="$(state_read "$name" 2>/dev/null | jq -c '.models // []' || true)"
        [[ -n "$models" ]] || models='[]'
    fi
    run_script "$type" "$name" uninstall "$@" || rc=$?
    if ((rc == EXIT_PRECONDITION)); then
        list="$(dependents "$name" | tr '\n' ' ')"
        [[ -z "$list" ]] || log_info "required by: $list"
    fi
    ((rc == 0)) || return "$rc"
    ((DRY)) && return 0
    case "$type" in
    engine) unwire_models "$name" "$models" ;;
    proxy | chat-interface) clear_wiring "$name" ;;
    esac
}

# uninstall_order <type-or-empty>: "type name" lines, dependents first, then
# the reverse install order; failed installs (manifest only) come last.
uninstall_order() {
    local scope="$1" pool=() n t i other on pending_only=() f order=() rt picked progress
    for t in chat-interface engine proxy provisioning; do
        [[ -z "$scope" || "$scope" == "$t" ]] || continue
        for n in $(state_list "$t"); do pool+=("$t $n"); done
    done
    while ((${#pool[@]})); do
        picked=""
        for i in "${!pool[@]}"; do
            read -r t n <<<"${pool[$i]}"
            progress=1
            for other in "${pool[@]}"; do
                read -r _ on <<<"$other"
                [[ "$on" == "$n" ]] && continue
                if state_read "$on" | jq -e --arg n "$n" --arg t "$t" '(.requires // []) | any(. == $n or . == $t)' >/dev/null; then
                    progress=0
                    break
                fi
            done
            if ((progress)); then
                picked="$i"
                break
            fi
        done
        picked="${picked:-0}"
        order+=("${pool[$picked]}")
        unset "pool[$picked]"
        pool=("${pool[@]}")
    done
    for f in "$(state_dir)"/pending/*.json; do
        [[ -e "$f" ]] || continue
        n="$(basename "$f" .json)"
        rt="$(jq -r '.type' "$f")"
        [[ -z "$scope" || "$scope" == "$rt" ]] || continue
        state_read "$n" >/dev/null 2>&1 || pending_only+=("$rt $n")
    done
    printf '%s\n' "${order[@]}" "${pending_only[@]}" | grep . || true
}

cmd_uninstall() {
    local type="" name="" all=0 args=() arg
    for arg in "$@"; do
        case "$arg" in
        --all) all=1 ;;
        --defaults) fail "$EXIT_USAGE" "--defaults is not accepted by uninstall" ;;
        --purge | --force) args+=("$arg") ;;
        -*) args+=("$arg") ;;
        *)
            if [[ -z "$type" ]]; then type="$arg"; elif [[ -z "$name" ]]; then name="$arg"; else args+=("$arg"); fi
            ;;
        esac
    done
    [[ -z "$type" ]] || is_type "$type" || fail "$EXIT_USAGE" "unknown component type '$type'" "types: ${TYPES[*]}"
    if ((all)); then
        [[ -z "$name" ]] || fail "$EXIT_USAGE" "--all cannot be combined with a component name"
        local t n list
        list="$(uninstall_order "$type")"
        if ((DRY)); then
            while read -r t n; do
                [[ -z "$n" ]] || log_info "plan: uninstall $t $n"
            done <<<"$list"
            return 0
        fi
        while read -r t n; do
            [[ -n "$n" ]] || continue
            log_info "uninstalling $t $n"
            uninstall_one "$t" "$n" "${args[@]}" || fail "$?" "could not uninstall $n"
        done <<<"$list"
        return 0
    fi
    if [[ -z "$name" ]]; then
        fail "$EXIT_USAGE" "uninstall needs a component" "easy-cs-ai uninstall <type> <name>, or easy-cs-ai uninstall --all"
    fi
    uninstall_one "$type" "$name" "${args[@]}"
}

# --- component commands -----------------------------------------------------------

# cmd_exec <type> <name> <command> [arguments…]: run the component's own program on the
# instance installed by easy-cs-ai, its arguments as they are, in the environment of
# describe.native.env. What runs is shown on stderr
# (--verbose) or planned (--dry-run), see docs/spec-cli.md#native-tool-commands.
cmd_exec() {
    local type="${1:-}" name="${2:-}" script desc state params env cmd line envs=() shown
    [[ -n "$type" ]] || fail "$EXIT_USAGE" "exec needs a component type, a name and a command" "easy-cs-ai exec <type> <name> <command> [arguments]"
    is_type "$type" || fail "$EXIT_USAGE" "unknown component type '$type'" "types: ${TYPES[*]}"
    [[ -n "$name" ]] || fail "$EXIT_USAGE" "exec needs a component name" "easy-cs-ai exec $type <name> <command> [arguments]"
    script="$(resolve_script "$type" "$name")"
    shift 2
    [[ $# -gt 0 ]] || fail "$EXIT_USAGE" "exec needs a command to run" "easy-cs-ai exec $type $name <command> [arguments]"
    ((!_OPT_JSON)) || fail "$EXIT_USAGE" "--json does not apply to exec: the output is the tool's" "the options of the CLI go before the command, without --json"
    desc="$(bash "$script" describe)"
    cmd="$(jq -r '.native.command // empty' <<<"$desc")"
    [[ -n "$cmd" ]] || fail "$EXIT_USAGE" "$name has no program of its own to run"
    state="$(state_read "$name" 2>/dev/null)" || fail "$EXIT_PRECONDITION" "$name is not installed"
    params="$(jq -c '(.params // {}) + { compose_file: (.service.compose_file // "") }' <<<"$state")"
    while IFS= read -r line; do
        [[ -z "$line" ]] || envs+=("$line")
    done < <(jq -r --argjson p "$params" '(.native.env // {}) | to_entries[]
        | "\(.key)=" + (reduce ($p | to_entries[]) as $e (.value; gsub("\\{" + $e.key + "\\}"; $e.value | tostring)))' <<<"$desc")
    cmd="$(jq -rn --arg c "$cmd" --argjson p "$params" 'reduce ($p | to_entries[]) as $e ($c; gsub("\\{" + $e.key + "\\}"; $e.value | tostring))')"
    # the program is the first word of the command (the rest is its fixed arguments)
    local -a words
    read -r -a words <<<"$cmd"
    shown="${envs[*]:+${envs[*]} }$cmd $*"
    if ((DRY)); then
        log_info "plan: exec $shown"
        return 0
    fi
    command -v "${words[0]}" >/dev/null 2>&1 || fail "$EXIT_PRECONDITION" "${words[0]} is not found on this machine" "is $name installed and ${words[0]} in the PATH?"
    log_debug "exec: $shown"
    for env in "${envs[@]}"; do
        export "${env?}"
    done
    exec "${words[@]}" "$@"
}

# component_rows <type>: one "<name><TAB>installed|not installed" row per component of the type.
component_rows() {
    local n
    for n in $(component_names "$1"); do
        printf '%s\t%s\n' "$n" "$(is_installed "$n" && printf installed || printf 'not installed')"
    done
}

# cmd_component [<type> [<name> <action> [arguments…]]]: the commands of the components, see
# docs/spec-cli.md#dispatch. With no name it is a listing, a human rendering that has no JSON form.
cmd_component() {
    local type="${1:-}" name="${2:-}" action="${3:-}" a t
    if [[ -z "$name" || "$name" == --json ]]; then
        local json="$_OPT_JSON"
        for a in "$@"; do
            [[ "$a" != --json ]] || json=1
        done
        ((!json)) || fail "$EXIT_USAGE" "component lists are not available with --json" \
            "for a program: easy-cs-ai catalog --json (what exists), easy-cs-ai status --json (what is installed)"
        if [[ -z "$type" || "$type" == --* ]]; then
            for t in "${TYPES[@]}"; do
                printf '%s\n' "$t"
                component_rows "$t" | sed 's/^/  /'
            done
        else
            is_type "$type" || fail "$EXIT_USAGE" "unknown component type '$type'" "types: ${TYPES[*]}"
            component_rows "$type"
        fi
        return 0
    fi
    local script actions
    script="$(resolve_script "$type" "$name")"
    shift 2 || true
    if [[ -z "$action" ]]; then
        run_script "$type" "$name" --help
        return
    fi
    if [[ "$action" != --* || "$action" == -- ]]; then
        # the actions come from the describe of the component, not from a list here
        actions="$(bash "$script" describe | jq -r '(.actions // []) | join(" ")')"
        if [[ " $actions " != *" $action "* ]]; then
            fail "$EXIT_USAGE" "unknown action '$action' for $type $name"                 "actions: $actions; to run the program of the component: easy-cs-ai exec $type $name $action …"
        fi
    fi
    if [[ "$CHANGING_ACTIONS" == *" $action "* ]] && ((!DRY)); then
        need_root component "$type" "$name" "$action"
    fi
    run_script "$type" "$name" "$@"
}

# --- generate ---------------------------------------------------------------------

# cmd_generate <args…>: hand over to the VM script generator, which reads the
# same scripts tree. Streams and exit code are the generator's.
cmd_generate() {
    local dir generator=""
    for dir in "$HOME_DIR/vm_script" "$HOME_DIR/../vm_script"; do
        [[ -f "$dir/generate.sh" ]] && generator="$dir/generate.sh" && break
    done
    [[ -n "$generator" ]] || fail "$EXIT_ERROR" "the generator is not installed (vm_script/generate.sh not found)"
    export EASY_CS_AI_HOME="$HOME_DIR" EASY_CS_AI_CLI_VERSION="$CLI_VERSION"
    local flags=()
    ((DRY)) && flags+=(--dry-run)
    ((_OPT_JSON)) && flags+=(--json)
    [[ "${EASY_CS_AI_VERBOSE:-0}" != 1 ]] || flags+=(--verbose)
    exec bash "$generator" "${flags[@]}" "$@"
}

# --- main -------------------------------------------------------------------------

# changing <command> <function> <args…>: a command that changes the machine; with
# --json it prints a result document at the end (see lib/cli-ai.sh).
changing() {
    local command="$1" fn="$2"
    shift 2
    if ((_OPT_JSON)); then
        run_with_result "$command" "$fn" "$@"
    else
        "$fn" "$@"
    fi
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --verbose) export EASY_CS_AI_VERBOSE=1; GFLAGS+=(--verbose) ;;
        --dry-run) DRY=1; GFLAGS+=(--dry-run) ;;
        --json) _OPT_JSON=1; GFLAGS+=(--json) ;;
        --help) usage; return 0 ;;
        --version) printf '%s\n' "$CLI_VERSION"; return 0 ;;
        *) break ;;
        esac
        shift
    done
    if [[ $# -eq 0 ]]; then
        usage >&2
        return "$EXIT_USAGE"
    fi
    local command="$1" a rest=()
    shift
    case "$command" in
    status | add | remove | apply | config | catalog | host | guide)
        # the general options are also accepted after these commands
        for a in "$@"; do
            case "$a" in
            --json) _OPT_JSON=1; GFLAGS+=(--json) ;;
            --dry-run) DRY=1; GFLAGS+=(--dry-run) ;;
            --verbose) export EASY_CS_AI_VERBOSE=1; GFLAGS+=(--verbose) ;;
            *) rest+=("$a") ;;
            esac
        done
        set -- "${rest[@]}"
        ;;
    esac
    case "$command" in
    install | uninstall)
        # --json is the CLI's; --dry-run stays with the components, which print their own plan
        for a in "$@"; do
            case "$a" in
            --json) _OPT_JSON=1; GFLAGS+=(--json) ;;
            --dry-run) PLAN_ONLY=1; rest+=("$a") ;;
            *) rest+=("$a") ;;
            esac
        done
        set -- "${rest[@]}"
        ;;
    esac
    case "$command" in
    help) usage ;;
    version) printf '%s\n' "$CLI_VERSION" ;;
    status) cmd_status "$@" ;;
    install) changing install cmd_install "$@" ;;
    uninstall) changing uninstall cmd_uninstall "$@" ;;
    add) changing add cmd_add "$@" ;;
    remove) changing remove cmd_remove "$@" ;;
    apply)
        # the dry run of apply prints the document of config validate itself
        if ((DRY)); then cmd_apply "$@"; else changing apply cmd_apply "$@"; fi
        ;;
    exec) cmd_exec "$@" ;;
    generate) cmd_generate "$@" ;;
    catalog) cmd_catalog "$@" ;;
    host) cmd_host "$@" ;;
    config) cmd_config "$@" ;;
    guide) cmd_guide "$@" ;;
    component) cmd_component "$@" ;;
    *)
        if is_type "$command"; then
            fail "$EXIT_USAGE" "unknown command '$command'" "the commands of a component go through component: easy-cs-ai component $command …"
        fi
        fail "$EXIT_USAGE" "unknown command '$command'" "run: easy-cs-ai help"
        ;;
    esac
}

main "$@"
