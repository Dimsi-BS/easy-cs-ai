# Managed by easy-cs-ai (librechat.sh): read by the LibreChat container. Holds secrets: mode 0600.
HOST=${LC_BIND}
PORT=${LC_PORT}
MONGO_URI=mongodb://ferret:${LC_DB_PASSWORD}@127.0.0.1:${LC_DB_PORT}/LibreChat
ALLOW_REGISTRATION=${LC_ALLOW_REGISTRATION}
DOMAIN_CLIENT=${LC_DOMAIN}
DOMAIN_SERVER=${LC_DOMAIN}
TRUST_PROXY=1
NO_INDEX=true
JWT_SECRET=${LC_JWT_SECRET}
JWT_REFRESH_SECRET=${LC_JWT_REFRESH_SECRET}
CREDS_KEY=${LC_CREDS_KEY}
CREDS_IV=${LC_CREDS_IV}
