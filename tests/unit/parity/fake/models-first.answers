# llmfit in the stack and ready: the models are named, the VM they need is only shown.
  # role of the VM: custom, the default
  # name of the VM: vm-1, the default
y  # provisioning
  # provisioning: llmfit
n  # proxy
y  # engine
  # engine: ollama
n  # chat-interface
  # ollama --port, the default
m  # order: models first
m1, m2  # models to add
y  # m1, m2 need a proxy: add prox? yes
y  # confirm
  # add another VM: no (default)
