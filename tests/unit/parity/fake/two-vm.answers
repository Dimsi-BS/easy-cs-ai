engine  # role of the first VM
  # name of the first VM: engine, the default
  # provisioning: llmfit, the rank 1
  # proxy: prox
  # engine: ollama
  # ollama --port, the default
m  # order: models first
m1  # models to add
y  # confirm the first VM
y  # add another VM
web  # role of the second VM
  # name it, default "web"
  # proxy: prox
  # chat interface: chat
  # chat --allow-registration, the default
y  # confirm the second VM
n  # no more VMs
  # where m1 is shown: web, the default
