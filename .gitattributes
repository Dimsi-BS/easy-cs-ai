# Shell scripts and bats tests must keep LF endings (run on Linux)
*.sh text eol=lf
*.bats text eol=lf
# Templates rendered into system files
*.service text eol=lf
.shellcheckrc text eol=lf
package/bin/* text eol=lf
*.tpl text eol=lf
# Data files read by the CLI (a CR would stick to the last field)
install_scripts/*.conf text eol=lf
install_scripts/templates/nginx/*.conf text eol=lf
install_scripts/templates/librechat/* text eol=lf
